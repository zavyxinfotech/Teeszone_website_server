# TeesZone API — copy to .env and fill in. .env is gitignored.

NODE_ENV=development
PORT=4010

# --- MySQL (local Homebrew MySQL 8) ---
# DATABASE_URL is used by Prisma (migrations); DB_* by Kysely (queries).
DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/teeszone"
DB_HOST=localhost
DB_PORT=3306
DB_NAME=teeszone
DB_USERNAME=root
DB_PASSWORD=YOUR_PASSWORD

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated emails allowed to log in as admin
ADMIN_EMAILS=madhan@revise.network

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Redis (local Homebrew Redis) ---
REDIS_URL=redis://localhost:6379

# --- Email (Resend) — optional in dev: OTPs/enquiries log to console when unset ---
RESEND_API_KEY=
MAIL_FROM="TeesZone <no-reply@teeszone.in>"
ENQUIRY_NOTIFY_EMAIL=

# --- S3 (product image uploads) — optional in dev: upload endpoint 503s when unset ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=
S3_ENDPOINT=
