{
  "name": "teeszone-api",
  "version": "1.0.0",
  "description": "TeesZone e-commerce API — Fastify 5 + Prisma/Kysely (MySQL) + Redis",
  "main": "build/src/server.js",
  "scripts": {
    "dev": "tsnd --transpile-only --respawn --exit-child src/server.ts",
    "build:tsc": "tsc && echo 'Build Completed Success'",
    "start": "NODE_ENV=production node build/src/server.js",
    "postinstall": "npx prisma generate",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:deploy": "npx prisma migrate deploy",
    "db:seed": "npx prisma db seed"
  },
  "prisma": {
    "seed": "tsnd --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@fastify/autoload": "^6.0.3",
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^10.2.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^6.1.0",
    "@prisma/client": "^6.2.0",
    "cls-rtracer": "^2.6.2",
    "dotenv": "^16.6.1",
    "envalid": "^8.0.0",
    "fastify": "^5.5.0",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "google-auth-library": "^10.9.1",
    "kysely": "^0.29.4",
    "magic-bytes.js": "^1.13.0",
    "mysql2": "^3.14.3",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "redis": "^4.7.0",
    "resend": "^6.5.2",
    "sharp": "^0.34.5",
    "zod": "^3.25.13"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "prisma": "^6.2.0",
    "prisma-kysely": "^2.3.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  }
}
