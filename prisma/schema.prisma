generator client {
  provider = "prisma-client-js"
}

generator kysely {
  provider     = "prisma-kysely"
  output       = "../kysely"
  fileName     = "types.ts"
  enumFileName = "enums.ts"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

// ---------- Navigation taxonomy (Segment -> SegmentGroup -> Collection) ----------

model Segment {
  id        String    @id @default(uuid()) @db.VarChar(191)
  slug      String    @unique @db.VarChar(191) // "unisex" | "men" | "women" | "kids" | "shop-more"
  name      String
  isNav     Boolean   @default(true) // shop-more: false — excluded from GET /navigation segments[]
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  groups      SegmentGroup[]
  collections Collection[]
}

model SegmentGroup {
  id        String    @id @default(uuid()) @db.VarChar(191)
  segmentId String    @db.VarChar(191)
  title     String    @db.VarChar(191) // "Tops", "Winter Essentials", …
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  segment     Segment      @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  collections Collection[]

  @@unique([segmentId, title])
}

model Collection {
  id          String    @id @default(uuid()) @db.VarChar(191)
  slug        String    @unique @db.VarChar(191)
  name        String
  description String    @db.Text
  isVirtual   Boolean   @default(false) // new-arrival / best-sellers / mega-sale (flag-driven, no join rows)
  segmentId   String    @db.VarChar(191)
  groupId     String    @db.VarChar(191)
  sortOrder   Int       @default(0) // order within its group
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  segment    Segment               @relation(fields: [segmentId], references: [id])
  group      SegmentGroup          @relation(fields: [groupId], references: [id])
  products   ProductCollection[]
  promotions PromotionCollection[]

  @@index([segmentId])
  @@index([groupId])
}

// ---------- Catalog ----------

model Product {
  id          String    @id @default(uuid()) @db.VarChar(191) // seed keeps the FE's existing "p-*" ids
  slug        String    @unique @db.VarChar(191)
  name        String
  description String    @db.Text
  fit         String    @db.VarChar(512)
  fabric      String
  gsm         Int
  mrp         Int // rupees; convert to paise only at the payment boundary (Phase 3)
  price       Int
  sizes       Json // ordered string[], e.g. ["S","M","L","XL","XXL"]
  features    Json // ordered string[]
  isNew       Boolean   @default(false)
  bestSeller  Boolean   @default(false)
  megaSale    Boolean   @default(false)
  isActive    Boolean   @default(true)
  sortOrder       Int       @default(0)
  ordersDelivered Int       @default(850)
  sizeChartImage  String?   @db.VarChar(512)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  colors       ProductColor[]
  colorModels  ProductColorModel[]
  qtyDiscounts ProductQtyDiscount[]
  collections  ProductCollection[]
  enquiries    Enquiry[]
  promotions   PromotionProduct[]

  @@index([isNew])
  @@index([bestSeller])
  @@index([megaSale])
}

model ProductColor {
  id          String    @id @default(uuid()) @db.VarChar(191)
  productId   String    @db.VarChar(191)
  name        String
  hex         String    @db.VarChar(9)
  image       String    @db.Text // Main Image
  backImage   String?   @db.Text
  chestImage  String?   @db.Text
  detailImage String?   @db.Text
  image4      String?   @db.Text
  image5      String?   @db.Text
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductColorModel {
  id                String   @id @default(uuid()) @db.VarChar(191)
  productId         String   @map("product_id") @db.VarChar(191)
  productColorId    String?  @map("product_colour_id") @db.VarChar(191)
  colorName         String   @map("colour_name") @db.VarChar(64)
  colorHex          String   @map("colour_hex") @db.VarChar(9)
  modelImageUrl     String   @map("model_image_url") @db.Text
  modelBackImageUrl String?  @map("model_back_image_url") @db.Text
  s3ObjectKey       String?  @map("s3_object_key") @db.VarChar(255)
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, colorName])
  @@index([productId])
  @@map("product_color_model")
}

model CustomizationColorModel {
  id                String   @id @default(uuid()) @db.VarChar(191)
  colorName         String   @unique @map("colour_name") @db.VarChar(64)
  colorSlug         String   @unique @map("colour_slug") @db.VarChar(64)
  colorHex          String   @map("colour_hex") @db.VarChar(9)
  modelImageUrl     String   @map("model_image_url") @db.Text
  modelBackImageUrl String?  @map("model_back_image_url") @db.Text
  s3FrontKey        String?  @map("s3_front_key") @db.VarChar(255)
  s3BackKey         String?  @map("s3_back_key") @db.VarChar(255)
  isActive          Boolean  @default(true) @map("is_active")
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([colorSlug])
  @@map("customization_color_model")
}

model ProductQtyDiscount {
  id        String   @id @default(uuid()) @db.VarChar(191)
  productId String   @db.VarChar(191)
  minQty    Int
  offPct    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, minQty])
}

model ProductCollection {
  id           String   @id @default(uuid()) @db.VarChar(191)
  productId    String   @db.VarChar(191)
  collectionId String   @db.VarChar(191)
  sortOrder    Int      @default(0) // position in product.collections[]; 0 = primary (breadcrumb/related)
  createdAt    DateTime @default(now())

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([productId, collectionId])
  @@index([collectionId])
}

model Fabric {
  id          String    @id @default(uuid())
  key         String    @unique // "single-jersey", …
  name        String
  description String    @db.Text
  fit         String    @db.VarChar(512)
  highlights  Json // ordered string[]
  image       String
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

model Review {
  id            String    @id @default(uuid())
  stars         Int
  quote         String    @db.Text
  author        String
  productName   String // free text — matches FE Review.product
  customerImage String?   @db.Text
  productImage  String?   @db.Text
  isPublished   Boolean   @default(false)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([isPublished])
}

// ---------- Promotions (admin-published discounts, Phase 2.6) ----------

enum PromotionType {
  PERCENT
  FLAT
}

enum PromotionScope {
  ALL
  PRODUCTS
  COLLECTIONS
}

model Promotion {
  id            String         @id @default(uuid())
  name          String
  code          String?        @unique // stored UPPERCASE
  type          PromotionType
  value         Int // PERCENT: 1-90 ; FLAT: rupees off per piece
  scope         PromotionScope @default(ALL)
  minQty        Int?
  minOrderValue Int?
  startsAt      DateTime?
  endsAt        DateTime?
  isActive      Boolean        @default(true)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  products    PromotionProduct[]
  collections PromotionCollection[]

  @@index([isActive])
}

model PromotionProduct {
  id          String   @id @default(uuid())
  promotionId String
  productId   String
  createdAt   DateTime @default(now())

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([promotionId, productId])
  @@index([productId])
}

model PromotionCollection {
  id           String   @id @default(uuid())
  promotionId  String
  collectionId String
  createdAt    DateTime @default(now())

  promotion  Promotion  @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([promotionId, collectionId])
  @@index([collectionId])
}

// ---------- Leads ----------

model Enquiry {
  id          String        @id @default(uuid())
  name        String
  company     String?
  phone       String
  productId   String?
  productName String? // snapshot of the product name at submit time
  quantity    String? // free text ("100 pcs")
  message     String?       @db.Text
  status      EnquiryStatus @default(NEW)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model NewsletterSubscriber {
  id        String    @id @default(uuid())
  email     String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // re-subscribe clears deletedAt (idempotent POST)
}

// ---------- Users & auth ----------

enum AddressType {
  HOME
  WORK
  OTHER
}

model User {
  id           String    @id @default(uuid())
  email        String?   @unique
  name         String?
  phone        String?
  company      String?
  passwordHash String? // null until the user sets one (Google-only accounts)
  googleId     String?   @unique // Google `sub`, set on first Google sign-in
  role         Role      @default(CUSTOMER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  addresses     Address[]
  resetTokens   PasswordResetToken[]
  likes         ProductLike[]
  cartItems     UserCartItem[]
  customDesigns UserCustomDesign[]
  orders        UserOrder[]
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique // sha256 of the token emailed to the user
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Address {
  id        String      @id @default(uuid())
  userId    String
  fullName  String
  phone     String
  line1     String // house no, building, street
  line2     String? // area, landmark
  city      String
  state     String
  pincode   String      @db.VarChar(10)
  type      AddressType @default(HOME)
  isDefault Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model HomeContent {
  id            String   @id @default("homepage") @db.VarChar(191)
  hero          Json
  shopByRange   Json
  fabricLibrary Json
  processSteps  Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ProductLike {
  id          String   @id @default(uuid()) @db.VarChar(64)
  userId      String   @db.VarChar(64)
  productSlug String   @db.VarChar(128)
  productName String   @db.VarChar(191)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productSlug])
  @@index([userId])
  @@index([productSlug])
  @@map("productlike")
}

model UserCartItem {
  id         String   @id @default(uuid()) @db.VarChar(191)
  userId     String   @db.VarChar(191)
  itemKey    String   @db.VarChar(255)
  slug       String   @db.VarChar(191)
  name       String   @db.VarChar(255)
  image      String   @db.Text
  colorName  String   @db.VarChar(100)
  colorHex   String   @db.VarChar(32)
  size       String   @db.VarChar(32)
  qty        Int      @default(1)
  customNote String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemKey])
  @@index([userId])
  @@map("usercartitem")
}

model UserCustomDesign {
  id                  String   @id @default(uuid()) @db.VarChar(191)
  userId              String   @db.VarChar(191)
  productId           String?  @db.VarChar(191)
  productSlug         String   @db.VarChar(191)
  productName         String   @db.VarChar(255)
  colorName           String   @db.VarChar(100)
  colorHex            String?  @db.VarChar(32)
  companyName         String?  @db.VarChar(255)
  logoUrl             String?  @db.Text
  logoName            String?  @db.VarChar(255)
  frontLogoUrl        String?  @db.Text
  backLogoUrl         String?  @db.Text
  frontPreviewUrl     String?  @db.Text
  backPreviewUrl      String?  @db.Text
  frontPositionPreset String?  @db.VarChar(50)
  backPositionPreset  String?  @db.VarChar(50)
  printLocation       String?  @db.VarChar(100)
  printType           String?  @db.VarChar(50)
  frontElements       Json?
  backElements        Json?
  customizationData   Json?
  embroideryNotes     String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([productSlug])
  @@map("usercustomdesign")
}

model CustomerActivity {
  id           String   @id @default(uuid()) @db.VarChar(191)
  userId       String?  @db.VarChar(191)
  userName     String?  @db.VarChar(255)
  userEmail    String?  @db.VarChar(255)
  activityType String   @db.VarChar(64)
  productId    String?  @db.VarChar(191)
  productName  String?  @db.VarChar(255)
  orderId      String?  @db.VarChar(191)
  status       String   @default("COMPLETED") @db.VarChar(64)
  details      Json?
  ipAddress    String?  @db.VarChar(64)
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([activityType])
  @@index([createdAt])
  @@map("customeractivity")
}

model UserOrder {
  id                String   @id @default(uuid()) @db.VarChar(191)
  orderNumber       String   @unique @db.VarChar(100)
  userId            String?  @db.VarChar(191)
  userName          String?  @db.VarChar(255)
  userEmail         String?  @db.VarChar(255)
  userPhone         String?  @db.VarChar(50)
  razorpayOrderId   String?  @db.VarChar(191)
  razorpayPaymentId String?  @db.VarChar(191)
  amount            Int
  currency          String   @default("INR") @db.VarChar(10)
  status            String    @default("Order Placed") @db.VarChar(50)
  paymentStatus     String    @default("PAID") @db.VarChar(50)
  items             Json
  shippingAddress   Json?
  trackingId        String?   @db.VarChar(100)
  courierName       String?   @db.VarChar(100)
  statusUpdatedAt   DateTime?
  reviewStatus      String    @default("Review Pending") @db.VarChar(50)
  internalRating    Int?
  reviewDismissedAt DateTime?
  socialDismissed   Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([status])
  @@map("userorder")
}
